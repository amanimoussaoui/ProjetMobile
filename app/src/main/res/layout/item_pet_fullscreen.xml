<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Main Card - Design moderne sans scroll -->
    <androidx.cardview.widget.CardView
        android:id="@+id/petCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="2dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/white"
        android:foreground="?android:attr/selectableItemBackground">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Pet Photo Container - CORRECTION ICI -->
            <RelativeLayout
                android:id="@+id/petPhotoContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_above="@id/petInfoContainer"
                android:layout_alignParentTop="true"
                android:background="@drawable/pet_photo_gradient">

                <!-- Paws décoratives dans le fond -->
                <TextView
                    android:id="@+id/paw1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="44sp"
                    android:textColor="@color/white"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="40dp"
                    android:alpha="0.18"
                    android:rotation="-12"/>

                <TextView
                    android:id="@+id/paw2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="38sp"
                    android:textColor="@color/white"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="70dp"
                    android:layout_marginTop="70dp"
                    android:alpha="0.16"
                    android:rotation="8"/>

                <TextView
                    android:id="@+id/paw3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="42sp"
                    android:textColor="@color/white"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="40dp"
                    android:layout_marginTop="50dp"
                    android:alpha="0.20"
                    android:rotation="15"/>

                <TextView
                    android:id="@+id/paw4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="36sp"
                    android:textColor="@color/white"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="30dp"
                    android:alpha="0.14"
                    android:rotation="-20"/>

                <!-- ⭐ CORRECTION: FrameLayout pour gérer l'image et l'emoji -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true">

                    <!-- Pet Photo - VISIBLE par défaut -->
                    <ImageView
                        android:id="@+id/petPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/pet_image_description"
                        android:background="@android:color/transparent"
                        android:visibility="visible"/>

                    <!-- Fallback Emoji - GONE par défaut -->
                    <TextView
                        android:id="@+id/petEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐕"
                        android:textSize="180sp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:elevation="0dp"/>

                </FrameLayout>

                <!-- Favorite Button -->
                <ImageView
                    android:id="@+id/favoriteButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="18dp"
                    android:padding="12dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:background="@drawable/favorite_button_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:contentDescription="@string/favorite_button_description"/>

                <!-- Overlay décoratif subtil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/gradient_overlay_bottom"/>

            </RelativeLayout>

            <!-- Pet Info Section - Compacte et élégante -->
            <LinearLayout
                android:id="@+id/petInfoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                android:elevation="0dp">

                <!-- Pet Name -->
                <TextView
                    android:id="@+id/petName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="start|center_vertical"
                    android:text="Buddy"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01" />

                <!-- Information Container - Age et Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Age Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp"
                        android:background="@drawable/info_pill_background"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="📅"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/petAge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="2 years old"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp"/>

                    <!-- Location Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/info_pill_background"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="📍"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/petLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="New York, NY"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Buttons Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- More Details Button -->
                    <Button
                        android:id="@+id/moreDetailsButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="DÉTAILS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal_primary"
                        android:background="@drawable/button_outline_teal"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:layout_marginEnd="10dp"/>

                    <!-- Adopt Button - Prominent -->
                    <Button
                        android:id="@+id/adoptButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="ADOPTER 🐾"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/button_gradient_teal"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"/>

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>